{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Jest Tests",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "node",
			"runtimeArgs": [
				"--experimental-vm-modules",
				"${workspaceFolder}/node_modules/jest/bin/jest.js",
				"--runInBand"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		}
	]
}
